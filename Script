-- ===== HTTP HELPERS =====
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url, true) end)
    if ok and res and res ~= "" then return res end
    if syn and syn.request then
        local ok2, r = pcall(function() return syn.request({ Url = url, Method = "GET" }) end)
        if ok2 and r and r.Body then return r.Body end
    end
    if type(request) == "function" then
        local ok3, r = pcall(function() return request({ Url = url, Method = "GET" }) end)
        if ok3 and r and r.Body then return r.Body end
    end
    if type(http_request) == "function" then
        local ok4, r = pcall(function() return http_request({ Url = url, Method = "GET" }) end)
        if ok4 and r and r.Body then return r.Body end
    end
    return nil
end

local function httpPut(url, data)
    local encoded = KeyHttpService:JSONEncode(data)
    if syn and syn.request then
        local ok, res = pcall(function()
            return syn.request({ Url = url, Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" }, Body = encoded })
        end)
        if ok and res then return true end
    end
    if type(request) == "function" then
        local ok, res = pcall(function()
            return request({ Url = url, Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" }, Body = encoded })
        end)
        if ok and res then return true end
    end
    if type(http_request) == "function" then
        local ok, res = pcall(function()
            return http_request({ Url = url, Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" }, Body = encoded })
        end)
        if ok and res then return true end
    end
    local ok, res = pcall(function()
        return KeyHttpService:RequestAsync({ Url = url, Method = "PUT",
            Headers = { ["Content-Type"] = "application/json" }, Body = encoded })
    end)
    return ok and res and res.Success
end

-- ===== KEY VALIDATION =====
local function validateKey(input)
    if not input or input == "" then return false, "Empty key" end
    local cleaned = input:gsub("%s+", ""):upper()
    local key = cleaned:match("^([^|]+)") or cleaned

    local body = httpGet(KEYS_URL)
    if not body then return false, "No internet – cannot verify" end

    local ok, allKeys = pcall(KeyHttpService.JSONDecode, KeyHttpService, body)
    if not ok or type(allKeys) ~= "table" then return false, "Server error – try again" end

    local record = allKeys[key]
    if not record then return false, "Invalid or used key" end

    local used = tonumber(record.used) or 0
    local max  = tonumber(record.max)  or MAX_USES
    if used >= max then return false, "Key already used (max reached)" end

    local newUsed = used + 1
    local newUsedBy = {}
    if type(record.usedBy) == "table" then
        for k, v in pairs(record.usedBy) do newUsedBy[k] = v end
    end
    newUsedBy[tostring(KeyLocalPlayer.UserId)] = os.time()

    local payload = {
        key = key, used = newUsed, max = max, usedBy = newUsedBy,
        createdAt = record.createdAt or os.time(),
        createdBy = record.createdBy or "web",
        lastUsedAt = os.time() * 1000,
    }

    local putOk = httpPut(FIREBASE_ROOT .. "/keys/" .. key .. ".json", payload)
    if not putOk then return false, "Failed to save usage" end

    local left = max - newUsed
    return true, "Valid (" .. left .. " use" .. (left == 1 and "" or "s") .. " left)"
end

